# Copy to ".env" (git-ignored) for local runs. Loaded by Env.Load() in Program.cs.
# Never commit real values.

# Required
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=campushostels;Username=postgres;Password=change-me"
# At least 32 characters. Generate one with:  openssl rand -base64 48
# The image server must use the SAME value.
JwtSettings__SecretKey="replace-with-a-long-random-value"

# Google sign-in (same client ID as VITE_GOOGLE_CLIENT_ID in the customer app)
# Authentication__GoogleClientId=

# First-time admin access. After the "LockSeededSuperAdmin" migration the seeded superadmin account
# has no usable password. Set this ONCE (12+ characters) to give it one, sign in, change it, then
# remove this line.
# Bootstrap__SuperManagerPassword=

# Optional integrations
# Paystack__SecretKey=
# Paystack__PublicKey=
# Smtp__Username=
# Smtp__Password=
# SendGrid__ApiKey=
# Whapi__Token=
