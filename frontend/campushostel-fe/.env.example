# Image host used to resolve stored image paths (default: live server)
# VITE_IMAGE_BASE_URL=https://campushostels.duckdns.org/image-service
# To view images uploaded to your local image-server instead:
# VITE_IMAGE_BASE_URL=http://localhost:5080

# Google sign-in. Create a "Web application" OAuth client in Google Cloud Console and add
# https://campushostels.duckdns.org and http://localhost:5173 as Authorised JavaScript origins.
# For local development put it here. In Docker/production it comes from Authentication__GoogleClientId in the
# server's .env (docker-compose passes it to both the API and this build).
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
