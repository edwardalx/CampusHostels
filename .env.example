# Template for the server's ".env" (read by docker compose and, via env_file, by the API and image server).
# Copy to ".env" on the server. NEVER commit the real file (it is git-ignored).

# --- Database -------------------------------------------------------------------------------
POSTGRES_DB=campushostels
POSTGRES_USER=campushostels
POSTGRES_PASSWORD=change-me
DB_PORT=5432

# --- Token signing (REQUIRED: the API and image server refuse to start without it) ----------
# At least 32 characters, generated randomly:  openssl rand -base64 48
# Changing it signs everyone out. Do not reuse a value that has ever been committed.
JwtSettings__SecretKey=

# --- Google sign-in -------------------------------------------------------------------------
# Same OAuth client ID in both (the API validates the tokens, the web app draws the button).
Authentication__GoogleClientId=
VITE_GOOGLE_CLIENT_ID=

# --- One-time admin recovery ----------------------------------------------------------------
# The seeded "superadmin" account is locked by a migration. Set a 12+ character password here,
# start the API once, sign in and change it, then DELETE this line.
# Bootstrap__SuperManagerPassword=

# --- Optional integrations ------------------------------------------------------------------
# Paystack__SecretKey=
# Paystack__PublicKey=
# Smtp__Username=
# Smtp__Password=
# SendGrid__ApiKey=
# Whapi__Token=
