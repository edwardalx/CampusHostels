# This file is intentionally disabled and is not included by nginx.
# Keep it as a reference template for upstreams without loading stale
# service definitions into the active nginx configuration.
#
# Example:
# upstream django_app {
#     server web:8000;
# }
#
# upstream bookshelf_app {
#     server app1_dotnet:6001;
# }
#
# location /.well-known/acme-challenge/ {
#     root /var/www/certbot;
# }