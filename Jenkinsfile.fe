pipeline {
    agent any

    parameters {
        choice(
            name: 'BRANCH',
            choices: ['main', 'develop'],
            description: 'Select git branch to deploy'
        )
    }

    environment {
        HOST_IP = "192.168.0.72"
        PROJECT_DIR = "/home/eobkwaku/jenkins-docker/CampusHostels"
    }

    stages {
        stage('Build and Deploy Frontend') {
            steps {
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'be7af895-440a-4af4-ad0a-685416674053',
                    keyFileVariable: 'SSH_KEY',
                    usernameVariable: 'SSH_USERNAME'
                )]) {
                    script {
                        sh """
                            ssh -o StrictHostKeyChecking=no -i "\$SSH_KEY" "\$SSH_USERNAME"@${env.HOST_IP} '
                                set -e
                                echo "=== Frontend Deployment at \$(date) ==="
                                
                                cd ${env.PROJECT_DIR}
                                
                                # Update the deployment checkout
                                git reset --hard HEAD
                                git pull origin main
                                
                                echo "🔨 Building and deploying both frontend apps..."
                                docker compose config --quiet
                                docker compose up -d --build frontend nginx

                                echo "🔎 Verifying manager build and nginx configuration..."
                                docker compose exec -T frontend test -s /usr/share/nginx/html/manager/index.html
                                docker exec campushostels_nginx nginx -t
                                curl --fail --silent --show-error --retry 5 --retry-delay 2 \\
                                    https://campushostels.duckdns.org/manager/ >/dev/null

                                echo "✅ Frontend deployment completed!"
                                echo "🌐 Check: https://campushostels.duckdns.org/"
                            '
                        """
                    }
                }
            }
        }
         stage('Verify Deployment') {
            steps {
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'be7af895-440a-4af4-ad0a-685416674053',
                    keyFileVariable: 'SSH_KEY',
                    usernameVariable: 'SSH_USERNAME'
                )]) {
                    script {
                        sh """
                            ssh -o StrictHostKeyChecking=no -i "\$SSH_KEY" "\$SSH_USERNAME"@${env.HOST_IP} '
                                echo "=== Verification ==="
                                
                                cd ${env.PROJECT_DIR}
                                
                                echo "📦 Frontend and nginx containers:"
                                docker compose ps frontend nginx

                                echo -e "\\\\n📊 Build info:"
                                echo "Branch: ${params.BRANCH}"
                                
                                echo -e "\\\\n✅ Deployment completed successfully!"
                            '
                        """
                    }
                }
            }
        }
    }
    
    post {
        success {
            echo "✅ Frontend deployed successfully!"
        }
        failure {
            echo "❌ Frontend deployment failed!"
        }
    }
}