// Jenkinsfile.fe - Updated with proper checkout
pipeline {
    agent any
    
    parameters {
        choice(
            name: 'BRANCH',
            choices: ['main', 'develop'],
            description: 'Select git branch to deploy'
        )
    }

    environment {
        HOST_IP = "192.168.0.72"
        PROJECT_DIR = "/home/eobkwaku/jenkins-docker/CampusHostels"
    }

    stages {
        stage('Checkout Code') {
            steps {
                script {
                    // Checkout the selected branch
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "*/${params.BRANCH}"]],
                        userRemoteConfigs: [[
                            url: 'https://github.com/edwardalx/CampusHostels.git'
                        ]]
                    ])
                    
                    echo "✅ Checked out branch: ${params.BRANCH}"
                }
            }
        }
        
        stage('Build and Deploy Frontend') {
            steps {
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'be7af895-440a-4af4-ad0a-685416674053',
                    keyFileVariable: 'SSH_KEY',
                    usernameVariable: 'SSH_USERNAME'
                )]) {
                    script {
                        sh """
                            ssh -o StrictHostKeyChecking=no -i "\$SSH_KEY" "\$SSH_USERNAME"@${env.HOST_IP} '
                                set -e
                                echo "=== Frontend Deployment from branch ${params.BRANCH} ==="
                                
                                cd ${env.PROJECT_DIR}
                                
                                echo "🔨 Building frontend..."
                                cd frontend/campushostel-fe
                                
                                # Clean and build
                                rm -rf node_modules package-lock.json
                                npm install --force --legacy-peer-deps
                                npm run build
                                
                                echo "✅ Frontend built successfully"
                                
                                echo "📦 Deploying files..."
                                docker cp frontend/campushostel-fe/dist/. campushostels_nginx:/var/www/campushostels-fe/
                                
                                echo "🔄 Reloading nginx..."
                                docker exec campushostels_nginx nginx -s reload 2>/dev/null
                                
                                echo "✅ Frontend deployment completed!"
                            '
                        """
                    }
                }
            }
        }
    }
}